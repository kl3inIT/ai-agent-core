<?xml version="1.0" encoding="UTF-8"?>
<!--
    Plan 17-03 (MUT-16) — test-only agentstore persistence unit for the FK batch-load
    SELECT-count proxy (MutationFkBatchLoadQueryCountTest).

    WHY THIS FILE EXISTS
    ====================
    The agentstore EntityManagerFactory (AgentstoreStoreConfiguration ->
    JmixEntityManagerFactoryBean) does NOT scan @JmixEntity classes at runtime. As implemented
    in io.jmix.data.impl.JmixBaseEntityManagerFactoryBean#setupPersistenceUnit, it iterates the
    registered Jmix modules in REVERSE order and uses the first
    "{module.basePackage}/agentstore-persistence.xml" found on the classpath to define the
    persistence unit's managed classes.

    On the TEST classpath the only agentstore-persistence.xml previously present was the
    PRODUCTION one packaged in the main output at com/vn/agent/agentstore-persistence.xml, which
    lists only the production com.vn.agent.entity.* agentstore entities — so the test-only
    @Store("agentstore") fixtures (MutationStoreLinkedParentFixture / MutationStoreLinkedChildFixture)
    were absent from the agentstore PU and persisting one failed with
    "is not a known Entity type".

    This file lives at the com.vn.agent.tools.mutation module base package
    (MutationFixturePersistenceTestConfiguration, @JmixModule id="com.vn.agent.mutation.test").
    That module depends on AIConfiguration, so it is iterated BEFORE the production
    com.vn.agent module in the reverse loop and this file wins the lookup — exactly mirroring how
    the existing hand-written com/vn/agent/tools/mutation/persistence.xml shadows the production
    main-store PU for the main-store mutation fixtures.

    CONTENTS
    ========
    The full production agentstore class set (kept in sync with
    src/main/resources/com/vn/agent/agentstore-persistence.xml, generated by the Jmix gradle
    plugin) PLUS the two test fixtures, so every existing agentstore test still sees all real
    ai_* entities and the FK proxy test additionally sees the fixtures. The mapping-file points
    at the production (empty) agentstore-orm.xml on the main classpath.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="agentstore">
        <provider>io.jmix.data.impl.JmixPersistenceProvider</provider>
        <mapping-file>com/vn/agent/agentstore-orm.xml</mapping-file>
        <class>io.jmix.securitydata.entity.StringCollectionConverter</class>
        <class>io.jmix.core.entity.UriConverter</class>
        <class>io.jmix.core.entity.FileRefConverter</class>
        <class>com.vn.agent.exposure.AiExposureRule</class>
        <class>com.vn.agent.entity.AiExtractionDraft</class>
        <class>com.vn.agent.entity.AiConversation</class>
        <class>com.vn.agent.entity.AiParameters</class>
        <class>com.vn.agent.entity.AiTaskFile</class>
        <class>com.vn.agent.entity.AiMessage</class>
        <class>com.vn.agent.entity.AiAuditEvent</class>
        <class>com.vn.agent.entity.AiKnowledgeDocument</class>
        <class>com.vn.agent.entity.AiUiSettings</class>
        <class>com.vn.agent.tools.mutation.AiMutationIntent</class>
        <class>com.vn.agent.tools.mutation.fixture.MutationStoreLinkedParentFixture</class>
        <class>com.vn.agent.tools.mutation.fixture.MutationStoreLinkedChildFixture</class>
        <exclude-unlisted-classes/>
        <properties>
            <property name="eclipselink.weaving" value="static"/>
            <property name="io.jmix.enhancing.converters-list"
                      value="io.jmix.core.entity.FileRefConverter;io.jmix.core.entity.UriConverter;io.jmix.securitydata.entity.StringCollectionConverter"/>
        </properties>
    </persistence-unit>
</persistence>
