<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="main">
        <provider>io.jmix.data.impl.JmixPersistenceProvider</provider>
        <mapping-file>io/jmix/securitydata/orm.xml</mapping-file>
        <class>io.jmix.securitydata.entity.RowLevelPolicyEntity</class>
        <class>io.jmix.securitydata.entity.RoleAssignmentEntity</class>
        <class>io.jmix.securitydata.entity.StringCollectionConverter</class>
        <class>io.jmix.securitydata.entity.UserSubstitutionEntity</class>
        <class>io.jmix.securitydata.entity.RowLevelRoleEntity</class>
        <class>io.jmix.core.entity.UriConverter</class>
        <class>io.jmix.securitydata.entity.ResourceRoleEntity</class>
        <class>io.jmix.securitydata.entity.ResourcePolicyEntity</class>
        <class>io.jmix.core.entity.FileRefConverter</class>
        <class>com.vn.agent.tools.mutation.fixture.MutationTestFixture</class>
        <class>com.vn.agent.tools.mutation.fixture.MutationParentFixture</class>
        <class>com.vn.agent.tools.mutation.fixture.MutationChildFixture</class>
        <class>com.vn.agent.tools.mutation.fixture.MutationLinkedParentFixture</class>
        <class>com.vn.agent.tools.mutation.fixture.MutationLinkedChildFixture</class>
        <exclude-unlisted-classes/>
        <properties>
            <property name="eclipselink.weaving" value="static"/>
            <property name="io.jmix.enhancing.converters-list"
                      value="io.jmix.securitydata.entity.StringCollectionConverter;io.jmix.core.entity.UriConverter;io.jmix.core.entity.FileRefConverter"/>
        </properties>
    </persistence-unit>
</persistence>
