<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg:///exposureRulesDetail.title.new"
      focusComponent="entityNameComboBox">
    <data>
        <instance id="exposureRuleDc" class="com.vn.agent.exposure.AiExposureRule">
            <fetchPlan extends="_base"/>
            <loader id="exposureRuleDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout padding="true" spacing="true">
        <formLayout id="ruleForm" dataContainer="exposureRuleDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>
            <!-- entityNameComboBox: ComboBox<MetaClass>, populated programmatically in the Java
                 controller from MetaclassComboBoxHelper. NOT bound via property= because
                 MetaClass != String; the controller writes the selected metaclass name back
                 onto AiExposureRule.entityName via @ValueChangeEvent. -->
            <comboBox id="entityNameComboBox"
                      label="msg:///exposureRulesDetail.field.entityName"
                      placeholder="msg:///exposureRulesDetail.field.entityName.placeholder"
                      helperText="msg:///exposureRulesDetail.field.entityName.helper"
                      required="true"
                      width="100%"/>
            <checkbox id="enabledCheckbox"
                      label="msg:///exposureRulesDetail.field.enabled"
                      dataContainer="exposureRuleDc"
                      property="enabled"/>
        </formLayout>
        <hbox id="detailActions" spacing="true">
            <button id="saveBtn"
                    action="saveAction"
                    text="msg:///exposureRulesDetail.action.save"
                    themeNames="primary"/>
            <button id="cancelBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
