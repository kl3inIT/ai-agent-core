<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://title"
      focusComponent="documentsDataGrid">
    <data>
        <collection id="documentsDc" class="com.vn.agent.entity.AiKnowledgeDocument">
            <fetchPlan extends="_base"/>
            <loader id="documentsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ai_AiKnowledgeDocument e order by e.createdDate desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout padding="true" spacing="true">
        <upload id="documentUpload"
                acceptedFileTypes="application/pdf,text/markdown,text/plain,text/html,.pdf,.md,.txt,.html"
                maxFiles="10"
                maxFileSize="10485760"
                dropLabel="msg://upload.placeholder"
                uploadText="msg://upload.button"
                width="100%"/>
        <dataGrid id="documentsDataGrid"
                  dataContainer="documentsDc"
                  width="100%"
                  minHeight="20em"
                  themeNames="compact">
            <actions>
                <action id="reingest"
                        type="list_itemTracking"
                        text="msg://action.reingest"/>
                <action id="delete"
                        type="list_itemTracking"
                        text="msg://action.delete"/>
            </actions>
            <columns resizable="true">
                <column property="fileName" header="msg://column.filename"/>
                <column property="mimeType" header="msg://column.mimeType"/>
                <column key="status" header="msg://column.status"/>
                <column property="createdDate" header="msg://column.uploadedDate"/>
            </columns>
        </dataGrid>
        <hbox id="rowActionsBar" spacing="true">
            <button id="reingestBtn" action="documentsDataGrid.reingest"/>
            <button id="deleteBtn" action="documentsDataGrid.delete" themeNames="error"/>
        </hbox>
    </layout>
</view>
