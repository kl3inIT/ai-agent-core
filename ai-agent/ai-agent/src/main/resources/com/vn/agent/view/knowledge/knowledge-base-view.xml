<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg:///knowledgeBase.title"
      focusComponent="documentsDataGrid">
    <data>
        <collection id="documentsDc" class="com.vn.agent.entity.AiKnowledgeDocument">
            <fetchPlan extends="_base"/>
            <loader id="documentsDl" readOnly="true">
                <query>
                    <![CDATA[select e from ai_AiKnowledgeDocument e order by e.createdDate desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout padding="true" spacing="true">
        <formLayout id="uploadMetaForm" width="100%">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <comboBox id="sourceEntityNameComboBox"
                      label="msg:///knowledgeBase.upload.field.sourceEntityName"
                      helperText="msg:///knowledgeBase.upload.field.sourceEntityName.helper"
                      clearButtonVisible="true"
                      width="100%"/>
            <!--
                WARNING-08: allowedRoles selector for the upload form. Without it, every
                uploaded document landed with an empty allowedRoles list and was invisible
                to all non-admin users (D-05 fail-closed retrieval contract). Items are
                populated programmatically from ResourceRoleRepository minus system-* roles
                (see WARNING-02 filter). Helper text reminds the admin that an empty
                selection means "admin-only".
            -->
            <checkboxGroup id="uploadAllowedRolesGroup"
                           label="msg:///knowledgeBase.upload.field.allowedRoles"
                           helperText="msg:///knowledgeBase.upload.field.allowedRoles.helper"
                           width="100%"/>
        </formLayout>
        <!--
            WARNING-03: receiverType="..." was removed because it routes through the deprecated
            Vaadin Upload.setReceiver(...) (24.8 forRemoval=true) — the controller wires the
            non-deprecated UploadHandler.toFile(...) path in onInit. Keeping both led to
            ambiguous, version-dependent behaviour (MEMORY feedback_jmix_upload_receiver_deprecated).
        -->
        <upload id="documentUpload"
                acceptedFileTypes="application/pdf,text/markdown,text/plain,text/html,.pdf,.md,.txt,.html"
                maxFiles="10"
                maxFileSize="10485760"
                dropLabel="msg:///knowledgeBase.upload.placeholder"
                uploadText="msg:///knowledgeBase.upload.button"
                width="100%"/>
        <dataGrid id="documentsDataGrid"
                  dataContainer="documentsDc"
                  width="100%"
                  minHeight="20em"
                  themeNames="compact">
            <actions>
                <action id="editPermissions"
                        type="list_itemTracking"
                        text="msg:///knowledgeBase.action.editPermissions"/>
                <action id="reingest"
                        type="list_itemTracking"
                        text="msg:///knowledgeBase.action.reingest"/>
                <action id="delete"
                        type="list_itemTracking"
                        text="msg:///knowledgeBase.action.delete"/>
            </actions>
            <columns resizable="true">
                <column property="fileName" header="msg:///knowledgeBase.column.filename"/>
                <column property="mimeType" header="msg:///knowledgeBase.column.mimeType"/>
                <column key="status" header="msg:///knowledgeBase.column.status"/>
                <column key="sourceEntity" header="msg:///knowledgeBase.column.sourceEntity"/>
                <column property="createdDate" header="msg:///knowledgeBase.column.uploadedDate"/>
                <column key="actions" header="msg:///common.column.actions"/>
            </columns>
        </dataGrid>
        <hbox id="rowActionsBar" spacing="true">
            <button id="editPermissionsBtn" action="documentsDataGrid.editPermissions"/>
            <button id="reingestBtn" action="documentsDataGrid.reingest"/>
            <button id="deleteBtn" action="documentsDataGrid.delete" themeNames="error"/>
        </hbox>
    </layout>
</view>
