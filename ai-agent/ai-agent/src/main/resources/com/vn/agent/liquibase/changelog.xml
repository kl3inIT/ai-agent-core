<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Master changelog for the ai-agent add-on. Hosts MUST include this from their master
         changelog: <include file="/com/vn/agent/liquibase/changelog.xml"/>. Add-on changelogs
         are NOT auto-discovered by Jmix (verified per Phase 2 research).

         Explicit <include> rather than <includeAll> because Liquibase classpath directory
         scanning fails when the add-on is packaged as a JAR (Maven Local resolution). -->

    <!-- Liquibase type properties. Declared here so the add-on's integration tests
         (which load only this changelog) can resolve ${uuid.type}. Hosts that also
         declare these properties will get a harmless override. -->
    <property name="uuid.type" value="uuid" dbms="postgresql"/>
    <property name="uuid.type" value="varchar(36)" dbms="hsqldb"/>
    <property name="uuid.type" value="uniqueidentifier" dbms="mssql"/>
    <property name="offsetDateTime.type" value="timestamp with time zone" dbms="postgresql"/>
    <property name="offsetDateTime.type" value="timestamp" dbms="hsqldb"/>
    <property name="offsetDateTime.type" value="datetimeoffset" dbms="mssql"/>

</databaseChangeLog>
