<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg:///auditList.detail.title">
    <layout padding="true" spacing="true">
        <textField id="startedAtField"
                   label="msg:///auditList.detail.startedAt"
                   readOnly="true"/>
        <textField id="userField"
                   label="msg:///auditList.detail.user"
                   readOnly="true"/>
        <textField id="kindField"
                   label="msg:///auditList.detail.kind"
                   readOnly="true"/>
        <textField id="eventNameField"
                   label="msg:///auditList.detail.eventName"
                   readOnly="true"/>
        <textField id="runIdField"
                   label="msg:///auditList.detail.runId"
                   readOnly="true"/>
        <textField id="latencyMsField"
                   label="msg:///auditList.detail.latencyMs"
                   readOnly="true"/>
        <textField id="errorClassField"
                   label="msg:///auditList.detail.errorClass"
                   readOnly="true"/>
        <textField id="denialReasonField"
                   label="msg:///auditList.detail.denialReason"
                   readOnly="true"/>
        <vbox id="outcomeBox" padding="false" spacing="false">
            <span text="msg:///auditList.detail.outcome"/>
            <span id="outcomeBadge"/>
        </vbox>
        <textArea id="argumentsField"
                  label="msg:///auditList.detail.argsJson"
                  readOnly="true"
                  width="100%"
                  minHeight="14em"/>
        <textArea id="resultField"
                  label="msg:///auditList.detail.resultSummary"
                  readOnly="true"
                  width="100%"
                  minHeight="14em"/>
        <hbox width="100%" justifyContent="END" spacing="true">
            <button id="closeBtn"
                    text="msg:///auditList.detail.close"/>
        </hbox>
    </layout>
</view>
