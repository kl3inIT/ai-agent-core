<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Spring AI 1.1.4 chat-memory JDBC schema (PostgreSQL variant, ported from
        spring-ai/memory/repository/spring-ai-model-chat-memory-repository-jdbc/src/main/resources/
        org/springframework/ai/chat/memory/repository/jdbc/schema-postgresql.sql).

        NOTE: Table name "SPRING_AI_CHAT_MEMORY" is hard-coded in JdbcChatMemoryRepository.
        This is the documented exception to the AI_AGENT_* prefix rule (ENT-02).
        Host must set spring.ai.chat.memory.repository.jdbc.initialize-schema=never.
    -->

    <!-- ====== PostgreSQL variant ====== -->
    <changeSet id="1-postgres" author="ai-agent" dbms="postgresql">
        <sql>
            CREATE TABLE IF NOT EXISTS SPRING_AI_CHAT_MEMORY (
                conversation_id VARCHAR(36) NOT NULL,
                content TEXT NOT NULL,
                type VARCHAR(10) NOT NULL CHECK (type IN ('USER','ASSISTANT','SYSTEM','TOOL')),
                "timestamp" TIMESTAMP NOT NULL
            );
        </sql>
        <sql>
            CREATE INDEX IF NOT EXISTS SPRING_AI_CHAT_MEMORY_CONVERSATION_ID_TIMESTAMP_IDX
            ON SPRING_AI_CHAT_MEMORY(conversation_id, "timestamp");
        </sql>
    </changeSet>

</databaseChangeLog>
