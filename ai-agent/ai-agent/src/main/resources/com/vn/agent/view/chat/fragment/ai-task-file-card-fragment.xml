<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <!--
        Phase 13.1 Plan 04 — Per-row task-file card.
        Verbatim CRM port of ai-attachment-card-fragment.xml with five D-B1 adaptations:
        (1) entity name (AiTaskFile), (2) instance container id (taskFileDc),
        (3) <h5> property (filename), (4) +1 TRASH delete button, (5) sizeValue replaces
        source icon hbox. Wired by AiTaskFileCardFragmentRenderer via @RendererItemContainer.
    -->
    <data readOnly="true">
        <instance id="taskFileDc" class="com.vn.agent.entity.AiTaskFile"/>
    </data>
    <content>
        <card id="taskFileCard" width="100%" themeNames="outlined">
            <headerPrefix>
                <icon id="attachmentIcon" icon="FILE_O" size="S"/>
            </headerPrefix>
            <header>
                <h5 id="titleValue"
                    dataContainer="taskFileDc"
                    property="filename"/>
            </header>
            <headerSuffix>
                <hbox spacing="false" alignItems="CENTER">
                    <button id="openButton"
                            icon="DOWNLOAD"
                            themeNames="tertiary-inline small icon"/>
                    <button id="deleteButton"
                            icon="TRASH"
                            themeNames="tertiary-inline small icon"/>
                </hbox>
            </headerSuffix>
            <content>
                <hbox id="metaLayout"
                      spacing="true"
                      alignItems="CENTER"
                      classNames="attachment-card-meta">
                    <span id="timestampValue"
                          dataContainer="taskFileDc"
                          property="createdDate"
                          classNames="text-secondary text-s"/>
                    <span id="sizeSeparator"
                          text="|"
                          classNames="text-secondary text-s attachment-card-meta-separator"/>
                    <span id="sizeValue"
                          classNames="text-secondary text-s"/>
                </hbox>
            </content>
        </card>
    </content>
</fragment>
