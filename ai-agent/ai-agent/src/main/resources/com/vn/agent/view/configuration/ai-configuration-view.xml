<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg:///aiConfiguration.title"
      focusComponent="parametersDataGrid">
    <data>
        <collection id="parametersDc" class="com.vn.agent.entity.AiParameters">
            <fetchPlan extends="_base"/>
            <loader id="parametersDl" readOnly="true">
                <query>
                    <![CDATA[select e from ai_AiParameters e order by e.active desc, e.profileName asc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout padding="true" spacing="true">
        <tabSheet id="configurationTabs" width="100%">
            <tab id="parametersTab" label="msg:///aiConfiguration.tab.parameters">
                <vbox id="parametersContent" padding="true" spacing="true" width="100%">
                    <hbox id="parametersButtonsPanel" classNames="buttons-panel">
                        <button id="createBtn" action="parametersDataGrid.createAction"/>
                        <button id="editBtn" action="parametersDataGrid.editAction"/>
                        <button id="removeBtn" action="parametersDataGrid.removeAction"/>
                        <button id="setActiveBtn"
                                action="parametersDataGrid.setActive"
                                themeNames="primary success"/>
                    </hbox>
                    <dataGrid id="parametersDataGrid"
                              width="100%"
                              minHeight="20em"
                              dataContainer="parametersDc">
                        <actions>
                            <action id="createAction" type="list_create"/>
                            <action id="editAction" type="list_edit"/>
                            <action id="removeAction" type="list_remove"/>
                            <action id="setActive"
                                    type="list_itemTracking"
                                    text="msg:///parametersList.action.setActive"/>
                        </actions>
                        <columns resizable="true">
                            <column property="profileName" header="msg:///parametersList.column.name"/>
                            <column key="model" header="msg:///parametersList.column.model"/>
                            <column key="status" header="msg:///parametersList.column.active"/>
                            <column property="createdDate"/>
                            <column key="actions" header="msg:///common.column.actions"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>
            <tab id="exposureRulesTab" label="msg:///aiConfiguration.tab.exposureRules">
                <vbox id="exposureRulesContent" padding="true" spacing="true" width="100%">
                    <multiSelectComboBox id="hiddenEntitiesField"
                                         label="msg:///aiConfiguration.exposure.hiddenEntities"
                                         helperText="msg:///aiConfiguration.exposure.hiddenEntities.helper"
                                         placeholder="msg:///aiConfiguration.exposure.hiddenEntities.placeholder"
                                         width="100%"/>
                    <hbox id="exposureRulesButtonsPanel" classNames="buttons-panel">
                        <button id="saveExposureRulesButton"
                                text="msg:///aiConfiguration.exposure.action.save"
                                themeNames="primary"/>
                        <button id="refreshExposureRulesButton"
                                text="msg:///aiConfiguration.exposure.action.refresh"/>
                    </hbox>
                </vbox>
            </tab>
            <tab id="promptContextTab" label="msg:///aiConfiguration.tab.promptContext">
                <vbox id="promptContextContent" padding="true" spacing="true" width="100%">
                    <hbox id="promptToolbar"
                          width="100%"
                          alignItems="END"
                          justifyContent="BETWEEN"
                          padding="false"
                          spacing="true">
                        <textField id="generatedAtField"
                                   label="msg:///baselineContext.generatedAt"
                                   readOnly="true"/>
                        <textField id="activeProfileField"
                                   label="msg:///baselineContext.activeProfile"
                                   readOnly="true"/>
                        <textField id="previewConversationIdField"
                                   label="msg:///baselineContext.previewConversationId"
                                   readOnly="true"
                                   width="22em"/>
                        <button id="refreshPromptButton"
                                text="msg:///baselineContext.action.refresh"
                                themeNames="primary"/>
                    </hbox>
                    <codeEditor id="baselinePreviewField"
                                label="msg:///baselineContext.preview"
                                readOnly="true"
                                width="100%"
                                minHeight="24em"/>
                    <codeEditor id="composedPromptPreviewField"
                                label="msg:///baselineContext.composedPrompt"
                                readOnly="true"
                                width="100%"
                                minHeight="42em"/>
                </vbox>
            </tab>
            <tab id="tier1KnobsTab" label="msg:///aiUiSettings.tab.tier1Knobs">
                <vbox id="tier1Content" padding="true" spacing="true" width="100%">
                    <h4 id="tier1TaskFileHeader" text="msg:///aiUiSettings.tier1.section.taskFile"/>
                    <textField id="taskFileTtlSecondsField"
                               label="msg:///aiUiSettings.field.taskFileTtlSeconds"/>
                    <integerField id="taskFilePerTurnMaxFilesField"
                                  label="msg:///aiUiSettings.field.taskFilePerTurnMaxFiles"/>
                    <textField id="taskFilePerTurnMaxTotalBytesField"
                               label="msg:///aiUiSettings.field.taskFilePerTurnMaxTotalBytes"/>
                    <textField id="taskFileMaxFileSizeBytesField"
                               label="msg:///aiUiSettings.field.taskFileMaxFileSizeBytes"/>

                    <h4 id="tier1MutationHeader" text="msg:///aiUiSettings.tier1.section.mutation"/>
                    <checkbox id="mutationConfirmationRequiredField"
                              label="msg:///aiUiSettings.field.mutationConfirmationRequired"/>
                    <textField id="mutationIdempotencyTtlSecondsField"
                               label="msg:///aiUiSettings.field.mutationIdempotencyTtlSeconds"/>
                    <integerField id="mutationBulkMaxRowsField"
                                  label="msg:///aiUiSettings.field.mutationBulkMaxRows"/>

                    <h4 id="tier1PromptToolsHeader" text="msg:///aiUiSettings.tier1.section.promptTools"/>
                    <integerField id="promptEntityInventoryLimitField"
                                  label="msg:///aiUiSettings.field.promptEntityInventoryLimit"/>
                    <integerField id="toolsMaxFilterDepthField"
                                  label="msg:///aiUiSettings.field.toolsMaxFilterDepth"/>

                    <h4 id="tier1TitleHeader" text="msg:///aiUiSettings.tier1.section.title"/>
                    <integerField id="titleMaxContextMessagesField"
                                  label="msg:///aiUiSettings.field.titleMaxContextMessages"/>
                    <integerField id="titleMinAssistantMessagesTriggerField"
                                  label="msg:///aiUiSettings.field.titleMinAssistantMessagesTrigger"/>

                    <h4 id="tier1UploadHeader" text="msg:///aiUiSettings.tier1.section.upload"/>
                    <textField id="uploadMaxFileSizeBytesField"
                               label="msg:///aiUiSettings.field.uploadMaxFileSizeBytes"/>

                    <hbox id="tier1ButtonsPanel" classNames="buttons-panel">
                        <button id="saveTier1Button"
                                text="msg:///aiUiSettingsDetail.action.save"
                                themeNames="primary"/>
                        <button id="resetTier1Button"
                                text="msg:///aiConfiguration.action.reset"/>
                    </hbox>
                </vbox>
            </tab>
            <tab id="generalTab" label="msg:///aiUiSettings.tab.general">
                <vbox id="generalContent" padding="true" spacing="true" width="100%">
                    <checkboxGroup id="enabledSurfacesField"
                                   label="msg:///aiUiSettingsDetail.field.enabledSurfaces"
                                   helperText="msg:///aiUiSettingsDetail.field.enabledSurfaces.helper"
                                   required="true"
                                   requiredMessage="msg:///aiUiSettingsDetail.validation.enabledSurfacesRequired"
                                   width="100%"/>
                    <radioButtonGroup id="defaultSurfaceField"
                                      label="msg:///aiUiSettingsDetail.field.defaultSurface"
                                      helperText="msg:///aiUiSettingsDetail.field.defaultSurface.helper"
                                      required="true"
                                      requiredMessage="msg:///aiUiSettingsDetail.validation.defaultSurfaceRequired"
                                      themeNames="vertical"
                                      width="100%"/>
                    <hbox id="generalButtonsPanel" classNames="buttons-panel">
                        <button id="saveGeneralButton"
                                text="msg:///aiUiSettingsDetail.action.save"
                                themeNames="primary"/>
                        <button id="resetGeneralButton"
                                text="msg:///aiConfiguration.action.reset"/>
                    </hbox>
                </vbox>
            </tab>
        </tabSheet>
    </layout>
</view>
