<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <content>
        <vbox id="rootLayout" width="100%" height="100%" padding="false" spacing="false">
            <div id="emptyStatePanel" width="100%">
                <h3 text="msg://chatView.empty.heading"/>
                <span text="msg://chatView.empty.body"/>
            </div>
            <scroller id="messageScroller" width="100%" height="100%">
                <vbox id="messageList" padding="true" spacing="true" width="100%"/>
            </scroller>
            <hbox id="inputBar" width="100%" alignItems="END" padding="true" spacing="true">
                <textArea id="messageInput"
                          width="100%"
                          placeholder="msg://chatView.input.placeholder"
                          minHeight="3em"
                          maxHeight="10em"/>
                <button id="sendButton"
                        text="msg://chatView.action.send"
                        themeNames="primary"/>
                <button id="stopButton"
                        text="msg://chatView.action.stop"
                        themeNames="tertiary"
                        visible="false"/>
            </hbox>
        </vbox>
    </content>
</fragment>
