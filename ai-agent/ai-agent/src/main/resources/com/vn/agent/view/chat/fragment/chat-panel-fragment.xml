<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <!--
        Phase 13 Plan 04 — D-04 / Blocker 1 fix.
        The previous Phase 12 layout used a horizontal splitter element with attachmentsPanel
        as the right pane (rejected option E per CONTEXT D-04). v1.1 has no other right-pane
        content (admin list view is deferred), so the splitter wrapper is removed; chatPanel
        is hoisted directly under rootLayout, and attachmentsPanel becomes a chip-strip vbox
        positioned BETWEEN messageListSlot and messageInputSlot (chip strip above MessageInput).

        Phase 13 Plan 04 — REVIEWS HIGH-4 fix.
        The upload element carries NO declarative receiver attribute — Vaadin 24.8 marks
        Upload.setReceiver / Upload.getReceiver forRemoval (project memory
        feedback_jmix_upload_receiver_deprecated). The handler is wired in Java via
        com.vaadin.flow.server.streams.UploadHandler.toFile(...) inside ChatPanelFragment.onReady,
        mirroring KnowledgeBaseView.documentUpload.
    -->
    <content>
        <vbox id="rootLayout" classNames="ai-agent-chat-panel"
              width="100%" height="100%" padding="false" spacing="false">
            <vbox id="chatPanel" width="100%" height="100%"
                  padding="false" spacing="false">
                <hbox id="titleBar" width="100%" alignItems="CENTER"
                      classNames="ai-agent-chat-panel__toolbar">
                    <h3 id="conversationTitle"
                        text="msg:///chatView.action.newChat"
                        classNames="m-0 ai-agent-chat-panel__title"/>
                    <button id="editConversationTitleButton"
                            icon="PENCIL"
                            title="msg:///chatView.action.editTitle"
                            ariaLabel="msg:///chatView.action.editTitle"
                            themeNames="tertiary-inline small icon"
                            visible="false"/>
                    <button id="newChatButton"
                            icon="PLUS"
                            title="msg:///chatView.action.newChat"
                            ariaLabel="msg:///chatView.action.newChat"
                            themeNames="tertiary-inline small icon"/>
                    <button id="stopButton"
                            text="msg:///chatView.action.stop"
                            themeNames="tertiary"
                            visible="false"/>
                </hbox>
                <vbox id="messageListSlot" width="100%" height="100%"
                      padding="false" spacing="false"
                      classNames="ai-agent-chat-panel__messages"/>

                <!-- Phase 13 Plan 04 — D-04 chip strip. Direct child of chatPanel,
                     positioned ABOVE messageInputSlot, NEVER inside a horizontal splitter
                     element (Blocker 1 — option E rejected).
                     Toggled visible by ChatPanelFragment when chips exist. -->
                <vbox id="attachmentsPanel"
                      width="100%"
                      padding="false"
                      spacing="false"
                      classNames="ai-agent-chat-panel__attachments"
                      visible="false"/>

                <vbox id="messageInputSlot" width="100%"
                      padding="false" spacing="false"
                      classNames="ai-agent-chat-panel__input">
                    <hbox id="attachRow" width="100%"
                          padding="false" spacing="true"
                          classNames="ai-agent-chat-panel__attach-row">
                        <button id="attachButton"
                                icon="PAPERCLIP"
                                text="msg:///chatView.attachments.button"
                                ariaLabel="msg:///chatView.attachments.button"
                                themeNames="tertiary-inline small"
                                visible="false"/>
                        <!-- REVIEWS HIGH-4: NO declarative receiver attribute. Upload handler
                             is wired in Java via UploadHandler.toFile(...) (project memory
                             feedback_jmix_upload_receiver_deprecated). Mirrors
                             knowledge-base-view.xml#documentUpload. -->
                        <upload id="upload"
                                acceptedFileTypes="application/pdf,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/html,text/plain,text/markdown,image/png,image/jpeg,image/gif,image/webp,.pdf,.csv,.doc,.docx,.xls,.xlsx,.html,.htm,.txt,.md,.png,.jpg,.jpeg,.gif,.webp"
                                maxFiles="10"
                                maxFileSize="104857600"
                                uploadText="msg:///chatView.attachments.button"
                                width="100%"/>
                    </hbox>
                </vbox>
            </vbox>
        </vbox>
    </content>
</fragment>
