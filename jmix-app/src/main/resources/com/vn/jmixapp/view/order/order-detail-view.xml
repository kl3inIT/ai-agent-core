<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://OrderDetailView.title"
      focusComponent="form">
    <data>
        <instance id="orderDc" class="com.vn.jmixapp.entity.Order">
            <fetchPlan extends="_base">
                <property name="customer" fetchPlan="_base"/>
                <property name="lines" fetchPlan="_base">
                    <property name="product" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader/>
            <collection id="linesDc" property="lines"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="orderDc">
            <textField id="numberField" property="number"/>
            <datePicker id="orderDateField" property="orderDate"/>
            <entityPicker id="customerField" property="customer">
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityPicker>
            <select id="statusField" property="status"/>
        </formLayout>

        <hbox id="linesButtons" classNames="buttons-panel">
            <button id="createLineButton" action="linesDataGrid.createAction"/>
            <button id="editLineButton" action="linesDataGrid.editAction"/>
            <button id="removeLineButton" action="linesDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="linesDataGrid" width="100%" minHeight="16em" dataContainer="linesDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="product"/>
                <column property="quantity"/>
                <column property="lineAmount"/>
            </columns>
        </dataGrid>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
