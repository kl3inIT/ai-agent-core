<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="jmix-app">
        <createTable tableName="ORDER_LINE">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="ORDER_ID" type="${uuid.type}">
                <constraints nullable="false"
                             foreignKeyName="FK_ORDER_LINE__ON_ORDER"
                             references="CUSTOMER_ORDER(ID)"/>
            </column>
            <column name="PRODUCT_ID" type="${uuid.type}">
                <constraints nullable="false"
                             foreignKeyName="FK_ORDER_LINE__ON_PRODUCT"
                             references="PRODUCT(ID)"/>
            </column>
            <column name="QUANTITY" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="jmix-app">
        <createIndex indexName="IDX_ORDER_LINE__ON_ORDER" tableName="ORDER_LINE">
            <column name="ORDER_ID"/>
        </createIndex>
        <createIndex indexName="IDX_ORDER_LINE__ON_PRODUCT" tableName="ORDER_LINE">
            <column name="PRODUCT_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
