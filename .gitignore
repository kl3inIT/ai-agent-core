.env
# Ignore local Claude Code state, but keep the installed Jmix skills under version control.
.claude/*
!.claude/skills/

# Plan 08-07 (R-07a): local nexus credentials must NEVER be committed.
# Use ~/.gradle/gradle.properties (user-global, untracked by definition) OR
# a project-local file matching one of these patterns (explicitly ignored).
nexus-credentials*
gradle-local.properties
**/nexus.properties

# Playwright MCP scratch output and ad-hoc UAT artifacts.
.playwright-mcp/
.playwright-uat/
/output/
phase14-dom.json

# JVM crash / replay logs (occasionally dropped by the Gradle test worker).
hs_err_pid*.log
replay_pid*.log

# Playwright / live-UAT accessibility-snapshot scratch dumped at repo root.
/bulk*.yml
/*-snapshot.yml
/input-area.yml

# Gradle bootRun scratch logs (jmix-app dev runs).
/jmix-app/.bootrun*.log

# Stray nested planning dir — canonical planning lives at repo-root /.planning/.
/ai-agent/.planning/
